---
import "../styles/global.css";
import SeoHead from "../components/SeoHead.astro";
import {
  getPaidBillingPlan,
  isFincodeCheckoutEnabled,
  isFincodeTestCheckoutEnabled,
} from "../lib/billingPlans";

export const prerender = false;

const pageTitle = "申込内容確認｜白音七";
const pageDescription = "白音七の有料サービスについて、価格、利用枠、支払方法、提供時期、解約・返金条件を確認するページです。";
const selectedPlan = getPaidBillingPlan(Astro.url.searchParams.get("plan"));
const checkoutConfigured = isFincodeCheckoutEnabled(import.meta.env.PUBLIC_FINCODE_CHECKOUT_ENABLED);
const fincodeTestPublicKey = import.meta.env.PUBLIC_FINCODE_TEST_PUBLIC_KEY;
const testPaymentEnabled = isFincodeTestCheckoutEnabled({
  enabled: import.meta.env.PUBLIC_FINCODE_TEST_PAYMENT_ENABLED,
  planId: selectedPlan?.id,
  publicKey: fincodeTestPublicKey,
});

if (!selectedPlan) {
  Astro.response.status = 404;
}

const billingLabel = selectedPlan?.billingType === "subscription" ? "月額・自動更新" : "買い切り";
const paymentTiming = selectedPlan?.billingType === "subscription"
  ? "初回申込時および以後の契約周期ごとに自動決済"
  : "申込時に決済";
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead title={pageTitle} description={pageDescription} />
  </head>
  <body class="fortune-body">
    <header class="fortune-header">
      <div class="fortune-container fortune-header-inner">
        <a href="/" class="fortune-logo"><span class="fortune-logo-mark"></span><span>白音七</span></a>
        <button class="fortune-mobile-menu-button" type="button" aria-label="メニューを開く" aria-expanded="false" onclick="const nav=this.parentElement.querySelector('.fortune-nav'); const open=!nav.classList.contains('is-open'); nav.classList.toggle('is-open', open); this.setAttribute('aria-expanded', String(open));"><span></span><span></span><span></span></button>
        <nav class="fortune-nav"><a href="/">TOP</a><a href="/join">料金・プラン</a><a href="/contact">お問い合わせ</a></nav>
      </div>
    </header>

    <main class="checkout-review-page">
      <section class="fortune-container">
        <div class="checkout-review-frame">
          <div class="fortune-kicker">ORDER REVIEW</div>
          <h1>申込内容確認</h1>

          {selectedPlan ? (
            <>
              <div class="checkout-review-state" role="status">
                {testPaymentEnabled
                  ? "現在はfincode TEST環境で決済動作を確認しています。本番カード決済はまだ開始していません。"
                  : "現在はfincode本番環境の審査・準備中です。申込条件は確認できますが、本番カード決済はまだ開始していません。"}
              </div>

              <dl class="checkout-review-list">
                <div><dt>商品名</dt><dd>{selectedPlan.displayName}</dd></div>
                <div><dt>価格</dt><dd>{selectedPlan.priceLabel}</dd></div>
                <div><dt>数量</dt><dd>1</dd></div>
                <div><dt>請求区分</dt><dd>{billingLabel}</dd></div>
                <div><dt>利用枠・提供内容</dt><dd><ul>{selectedPlan.features.map((feature) => <li>{feature}</li>)}</ul></dd></div>
                <div><dt>商品代金以外の必要料金</dt><dd>なし<br /><small>インターネット接続・通信に必要な費用は利用者負担です。</small></dd></div>
                <div><dt>支払方法</dt><dd>fincode byGMOを利用したクレジットカード決済</dd></div>
                <div><dt>支払時期</dt><dd>{paymentTiming}</dd></div>
                <div><dt>サービス提供時期</dt><dd>決済完了および白音七での決済確認後、原則として直ちに利用権へ反映します。処理に時間を要する場合は、決済完了から24時間以内を目安に反映します。</dd></div>
                <div><dt>解約方法</dt><dd>月額プランは、お問い合わせ先へのご連絡によりいつでも解約手続きが可能です。現在の契約期間末まで利用でき、次回以降の自動更新を停止します。</dd></div>
                <div><dt>返金・キャンセル</dt><dd>お客様都合による決済完了後のキャンセル・返金は原則として受け付けません。重複請求、サービス未提供、白音七側のシステム不具合等は、決済記録と利用状況を確認のうえ個別に対応します。月額プランの残期間に対する日割り返金は行いません。</dd></div>
              </dl>

              <div class="checkout-legal-links" aria-label="申込条件に関する文書">
                <a href="/terms">利用規約</a>
                <a href="/commercial-transactions">特定商取引法に基づく表記</a>
                <a href="/privacy">プライバシーポリシー</a>
                <a href="/contact">お問い合わせ</a>
              </div>

              {testPaymentEnabled ? (
                <section
                  class="checkout-test-payment"
                  data-fincode-test-checkout
                  data-public-key={fincodeTestPublicKey}
                  aria-labelledby="fincode-test-heading"
                >
                  <div class="checkout-test-badge">fincode TEST環境</div>
                  <h2 id="fincode-test-heading">300円・音声鑑定1回分のTEST決済</h2>
                  <p>実際の請求は発生しません。fincode公式のテストカードだけを使用してください。</p>
                  <p>このTESTでは決済と3Dセキュアの確認だけを行い、白音七の利用権は付与しません。</p>
                  <div id="fincode-test-card-ui" class="checkout-test-card-ui"></div>
                  <button class="fortune-btn gold checkout-test-submit" type="button">TESTカード決済へ進む</button>
                  <p class="checkout-test-status" role="status" aria-live="polite"></p>
                </section>
              ) : (
                <>
                  <button class="fortune-btn gold checkout-disabled-button" type="button" disabled aria-disabled="true">
                    カード決済へ進む
                  </button>
                  <p class="checkout-disabled-note">
                    {selectedPlan.id !== "voice_single" && import.meta.env.PUBLIC_FINCODE_TEST_PAYMENT_ENABLED === "true"
                      ? "このTESTでは音声鑑定1回分だけを対象としています。月額プランの決済はまだ開始しません。"
                      : checkoutConfigured
                        ? "決済機能はこのリリースでは未接続です。安全確認が完了するまでカード決済は開始しません。"
                        : "現在はfincode本番環境の審査・準備中のため、カード決済はまだ開始していません。"}
                  </p>
                </>
              )}
            </>
          ) : (
            <div class="checkout-invalid" role="alert">
              <h2>商品を確認できませんでした</h2>
              <p>料金ページから商品を選び直してください。URL上の価格や商品名は申込内容として使用しません。</p>
              <a class="fortune-btn secondary" href="/join">料金・プランへ戻る</a>
            </div>
          )}
        </div>
      </section>
    </main>

    <footer class="fortune-footer"><div class="fortune-container fortune-footer-inner"><div>© {new Date().getFullYear()} 白音七</div><nav class="fortune-footer-links"><a href="/terms">利用規約</a><a href="/privacy">プライバシーポリシー</a><a href="/commercial-transactions">特定商取引法に基づく表記</a><a href="/contact">お問い合わせ</a></nav></div></footer>

    <style>
      .checkout-review-page { min-height: 100vh; padding: 4rem 0 5rem; }
      .checkout-review-frame { border: 1px solid rgba(224,184,72,.3); border-radius: 24px; padding: clamp(1.4rem,4vw,2.8rem); background: linear-gradient(145deg,rgba(15,19,42,.96),rgba(16,14,34,.94)); box-shadow: 0 24px 70px rgba(0,0,0,.28); }
      .checkout-review-frame h1, .checkout-review-frame h2 { color: #fff0b8; }
      .checkout-review-frame h1 { margin: .8rem 0 1.3rem; font-size: clamp(2rem,5vw,3.4rem); }
      .checkout-review-state, .checkout-disabled-note { border: 1px solid rgba(224,184,72,.28); border-radius: 16px; padding: 1rem; color: #fff0b8; line-height: 1.8; background: rgba(224,184,72,.07); }
      .checkout-review-list { display: grid; gap: 0; margin: 1.4rem 0; border: 1px solid rgba(224,184,72,.22); border-radius: 18px; overflow: hidden; }
      .checkout-review-list > div { display: grid; grid-template-columns: minmax(180px,.36fr) minmax(0,1fr); border-bottom: 1px solid rgba(224,184,72,.16); }
      .checkout-review-list > div:last-child { border-bottom: 0; }
      .checkout-review-list dt, .checkout-review-list dd { margin: 0; padding: 1rem; line-height: 1.8; }
      .checkout-review-list dt { color: #ffe58f; font-weight: 800; background: rgba(224,184,72,.06); }
      .checkout-review-list dd { color: rgba(255,240,190,.84); }
      .checkout-review-list ul { margin: 0; padding-left: 1.2rem; }
      .checkout-legal-links { display: flex; flex-wrap: wrap; gap: .7rem 1rem; margin: 1.2rem 0; }
      .checkout-legal-links a { color: #ffe58f; }
      .checkout-disabled-button { width: 100%; opacity: .55; cursor: not-allowed; }
      .checkout-disabled-note { margin-top: .8rem; text-align: center; }
      .checkout-test-payment { margin-top: 1.4rem; padding: 1.2rem; border: 1px solid rgba(92,211,199,.5); border-radius: 18px; background: rgba(31,146,139,.1); }
      .checkout-test-payment h2 { margin: .7rem 0; }
      .checkout-test-payment p { color: rgba(255,255,255,.84); line-height: 1.7; }
      .checkout-test-badge { display: inline-block; padding: .3rem .7rem; border-radius: 999px; background: #1f928b; color: #fff; font-weight: 800; }
      .checkout-test-card-ui { min-height: 240px; margin: 1rem 0; border-radius: 12px; overflow: hidden; background: #fff; }
      .checkout-test-submit { width: 100%; }
      .checkout-test-submit:disabled { opacity: .55; cursor: wait; }
      .checkout-test-status { min-height: 1.7em; margin-bottom: 0; text-align: center; }
      .checkout-invalid p { color: rgba(255,240,190,.84); line-height: 1.8; }
      @media (max-width: 700px) { .checkout-review-page { padding: 1.4rem 0 3rem; } .checkout-review-frame { border-radius: 18px; } .checkout-review-list > div { grid-template-columns: 1fr; } .checkout-review-list dt { padding-bottom: .35rem; } .checkout-review-list dd { padding-top: .35rem; } }
    </style>

    <script>
      import { initFincode } from "@fincode/js";
      import { allowFincodeTestRedirectUrl } from "../lib/fincodeTestBrowser";

      const root = document.querySelector<HTMLElement>("[data-fincode-test-checkout]");
      if (root) {
        const publicKey = root.dataset.publicKey;
        const button = root.querySelector<HTMLButtonElement>(".checkout-test-submit");
        const status = root.querySelector<HTMLElement>(".checkout-test-status");
        let registrationIdempotencyKey = "";
        let executionIdempotencyKey = "";

        const setStatus = (message: string) => {
          if (status) status.textContent = message;
        };

        if (!publicKey?.startsWith("p_test_") || !button || !status) {
          if (button) button.disabled = true;
          setStatus("TEST決済の設定を確認できません。");
        } else {
          try {
            const fincode = await initFincode({ publicKey, isLiveMode: false });
            const ui = fincode.ui({ layout: "vertical", hidePayTimes: true });
            // @fincode/js@1.1.0のd.tsは"payments"ですが、公式SDK実行例のUI契約は"payment"です。
            const paymentUi = ui as unknown as {
              create: (method: "payment", appearance: { layout: "vertical"; hidePayTimes: true }) => void;
              mount: (elementId: string, width: string) => void;
              getFormData: typeof ui.getFormData;
            };
            paymentUi.create("payment", { layout: "vertical", hidePayTimes: true });
            paymentUi.mount("fincode-test-card-ui", "400");

            button.addEventListener("click", async () => {
              button.disabled = true;
              setStatus("fincode TEST環境へ安全に接続しています…");
              registrationIdempotencyKey ||= crypto.randomUUID();
              executionIdempotencyKey ||= crypto.randomUUID();

              try {
                const registeredResponse = await fetch("/api/billing/fincode/test/register", {
                  method: "POST",
                  headers: {
                    "content-type": "application/json",
                    "idempotency-key": registrationIdempotencyKey,
                  },
                  body: JSON.stringify({ plan: "voice_single" }),
                  credentials: "same-origin",
                  redirect: "error",
                });
                const registered = await registeredResponse.json();
                if (
                  !registeredResponse.ok
                  || registered?.ok !== true
                  || typeof registered.paymentId !== "string"
                  || typeof registered.accessId !== "string"
                  || registered.payType !== "Card"
                ) {
                  throw new Error("registration rejected");
                }

                const card = await paymentUi.getFormData();
                const resultUrl = new URL("/fincode/test/result", window.location.origin);
                resultUrl.searchParams.set("payment_id", registered.paymentId);
                const failureUrl = new URL(resultUrl);
                failureUrl.searchParams.set("outcome", "failure");
                fincode.setIdempotentKey(executionIdempotencyKey);

                const payment = await new Promise<Record<string, unknown>>((resolve, reject) => {
                  fincode.payments({
                    id: registered.paymentId,
                    pay_type: "Card",
                    access_id: registered.accessId,
                    card_no: card.cardNo,
                    security_code: card.CVC,
                    expire: card.expire,
                    holder_name: card.holderName,
                    method: "1",
                    return_url: resultUrl.href,
                    return_url_on_failure: failureUrl.href,
                  }, (httpStatus, response) => {
                    if (httpStatus === 200) resolve(response as unknown as Record<string, unknown>);
                    else reject();
                  }, reject);
                });
                const redirectUrl = allowFincodeTestRedirectUrl(payment.redirect_url);
                if (!redirectUrl) throw new Error("redirect rejected");
                setStatus("3Dセキュア認証へ移動します…");
                window.location.assign(redirectUrl);
              } catch {
                setStatus("TEST決済を開始できませんでした。入力内容と設定を確認してください。");
                button.disabled = false;
              }
            });
          } catch {
            button.disabled = true;
            setStatus("fincode公式カード入力画面を読み込めませんでした。");
          }
        }
      }
    </script>
  </body>
</html>
