---
import "../styles/global.css";
import SeoHead from "../components/SeoHead.astro";
import { BILLING_PLANS } from "../lib/billingPlans";

export const prerender = false;

const pageTitle = "白音七 有料プラン｜より深く受け取りたい方へ";
const pageDescription =
  "白音七の有料プラン案内ページです。ライトプラン、プレミアムプラン、単発音声1回分の内容をご確認いただけます。";
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead title={pageTitle} description={pageDescription} />
  </head>

  <body class="fortune-body">
    <header class="fortune-header">
      <div class="fortune-container fortune-header-inner">
        <a href="/" class="fortune-logo">
          <span class="fortune-logo-mark"></span>
          <span>白音七</span>
        </a>

        <button
          class="fortune-mobile-menu-button"
          type="button"
          aria-label="メニューを開く"
          aria-expanded="false"
          onclick="const nav=this.parentElement.querySelector('.fortune-nav'); const open=!nav.classList.contains('is-open'); nav.classList.toggle('is-open', open); this.setAttribute('aria-expanded', String(open)); this.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>

        <nav class="fortune-nav" id="navArea">
          <a href="/">TOP</a>
          <a href="/members">会員ページ</a>
          <a href="/history">履歴一覧</a>
          <a href="/privacy">プライバシーポリシー</a>
          <span id="authArea"></span>
        </nav>
      </div>
    </header>

    <main class="fortune-premium-page">
      <section class="fortune-container" style="padding: 48px 0 88px;">
        <div class="fortune-premium-page-frame">
          <div
            id="premiumContent"
            data-light-price={BILLING_PLANS.light.priceLabel}
            data-light-monthly-limit={BILLING_PLANS.light.lightMonthlyLimit}
            data-light-voice-limit={BILLING_PLANS.light.voiceMonthlyLimit}
            data-premium-price={BILLING_PLANS.premium.priceLabel}
            data-premium-light-limit={BILLING_PLANS.premium.lightMonthlyLimit}
            data-premium-deep-limit={BILLING_PLANS.premium.deepMonthlyLimit}
            data-premium-voice-limit={BILLING_PLANS.premium.voiceMonthlyLimit}
            data-voice-single-price={BILLING_PLANS.voice_single.priceLabel}
          ></div>
        </div>
      </section>
    </main>

    <footer class="fortune-footer">
      <div class="fortune-container fortune-footer-inner">
        <div>© {new Date().getFullYear()} 白音七</div>
        <nav class="fortune-footer-links" aria-label="フッターナビゲーション">
          <a href="/terms">利用規約</a>
          <a href="/privacy">プライバシーポリシー</a>
          <a href="/commercial-transactions">特定商取引法に基づく表記</a>
          <a href="/disclaimer">免責事項</a>
          <a href="/contact">お問い合わせ</a>
        </nav>
      </div>
    </footer>

    <script>
      import { getMembershipDisplayInfo } from "../lib/membership";
      import { resolvePublicRuntimeApiConfig } from "../lib/runtimeApiConfig";

      const runtimeApi = resolvePublicRuntimeApiConfig(import.meta.env);
      const USER_STATUS_ENDPOINT = runtimeApi.authEnabled ? (runtimeApi.membershipStatusUrl || "") : "";

      const authArea = document.getElementById("authArea");
      const premiumContent = document.getElementById("premiumContent");
      const billingCatalog = {
        light: {
          priceLabel: premiumContent?.dataset.lightPrice || "",
          monthlyLimit: premiumContent?.dataset.lightMonthlyLimit || "",
          voiceLimit: premiumContent?.dataset.lightVoiceLimit || "",
        },
        premium: {
          priceLabel: premiumContent?.dataset.premiumPrice || "",
          lightLimit: premiumContent?.dataset.premiumLightLimit || "",
          deepLimit: premiumContent?.dataset.premiumDeepLimit || "",
          voiceLimit: premiumContent?.dataset.premiumVoiceLimit || "",
        },
        voiceSingle: {
          priceLabel: premiumContent?.dataset.voiceSinglePrice || "",
        },
      };

      const AUTH_STORAGE_KEY = "to" + "ken";
      const authSession = localStorage.getItem(AUTH_STORAGE_KEY);
      const email = localStorage.getItem("loginEmail");
      const input = JSON.parse(localStorage.getItem("fortuneInput") || "null");

      function escapeHtml(value) {
        return String(value ?? "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#39;");
      }

      function normalizePlan(rawPlan) {
        const plan = String(rawPlan || "").toLowerCase();
        if (plan === "premium") return "premium";
        if (plan === "normal" || plan === "light" || plan === "member") return "normal";
        return "free";
      }

      function formatDate(value) {
        if (!value) return "未反映";
        try {
          return new Date(value).toLocaleString("ja-JP");
        } catch {
          return value;
        }
      }

      function getUserId() {
        return (
          localStorage.getItem("userId") ||
          localStorage.getItem("user_id") ||
          ""
        );
      }

      function buildExtraCard() {
        return `
          <article class="fortune-card" style="padding:24px; border-radius:22px;">
            <div style="display:inline-flex; margin-bottom:12px; padding:6px 12px; border-radius:999px; border:1px solid rgba(202,168,79,0.24); color:#f2dd9a; font-size:0.85rem;">
              買い切り
            </div>
            <h3 style="margin:0 0 12px; color:#fff0bf;">音声鑑定1回分</h3>
            <p style="line-height:1.8; color:#dbc979;">
              月額契約なしで、音声鑑定1回分の利用権を追加します。
            </p>
            <div style="margin-bottom:16px; color:#fff0bf; font-size:1.05rem; font-weight:700;">${escapeHtml(billingCatalog.voiceSingle.priceLabel)}</div>
            <a class="fortune-btn secondary" href="/checkout?plan=voice_single">申込内容を確認する</a>
          </article>
        `;
      }

      function buildNormalCard() {
        return `
          <article class="fortune-card" style="padding:24px; border-radius:22px;">
            <div style="display:inline-flex; margin-bottom:12px; padding:6px 12px; border-radius:999px; border:1px solid rgba(202,168,79,0.24); color:#f2dd9a; font-size:0.85rem;">
              月額ライト会員
            </div>
            <h3 style="margin:0 0 12px; color:#fff0bf;">ライト会員</h3>
            <p style="line-height:1.8; color:#dbc979;">
              ライト会員は、日々の鑑定と履歴確認を少し深く受け取りたい方向けの月額プランです。
            </p>
            <ul style="margin:16px 0 20px; padding-left:1.2rem; line-height:1.9; color:#dbc979;">
              <li>ライト鑑定 月${escapeHtml(billingCatalog.light.monthlyLimit)}回</li>
              <li>音声 月${escapeHtml(billingCatalog.light.voiceLimit)}枠</li>
              <li>無料機能と鑑定履歴の保存・閲覧</li>
              <li>深掘り鑑定は利用できません</li>
            </ul>
            <div style="margin-bottom:16px; color:#fff0bf; font-size:1.05rem; font-weight:700;">${escapeHtml(billingCatalog.light.priceLabel)}・自動更新</div>
            <a class="fortune-btn gold" href="/checkout?plan=light">申込内容を確認する</a>
          </article>
        `;
      }

      function buildPremiumCard() {
        return `
          <article class="fortune-card" style="padding:24px; border-radius:22px; border:1px solid rgba(182,140,255,0.4); box-shadow:0 0 30px rgba(182,140,255,0.12);">
            <div style="display:inline-flex; margin-bottom:12px; padding:6px 12px; border-radius:999px; border:1px solid rgba(182,140,255,0.34); color:#d9c2ff; font-size:0.85rem;">
              プレミアム
            </div>
            <h3 style="margin:0 0 12px; color:#fff0bf;">プレミアム会員</h3>
            <p style="line-height:1.8; color:#dbc979;">
              プレミアム会員は、より深い鑑定や音声での受け取り方を選べる月額プランです。
            </p>
            <ul style="margin:16px 0 20px; padding-left:1.2rem; line-height:1.9; color:#dbc979;">
              <li>ライト鑑定 月${escapeHtml(billingCatalog.premium.lightLimit)}回</li>
              <li>深掘り鑑定 月${escapeHtml(billingCatalog.premium.deepLimit)}回</li>
              <li>音声 月${escapeHtml(billingCatalog.premium.voiceLimit)}枠</li>
              <li>無料機能と鑑定履歴の保存・閲覧</li>
            </ul>
            <div style="margin-bottom:16px; color:#fff0bf; font-size:1.05rem; font-weight:700;">${escapeHtml(billingCatalog.premium.priceLabel)}・自動更新</div>
            <a class="fortune-btn violet" href="/checkout?plan=premium">申込内容を確認する</a>
          </article>
        `;
      }

      function buildPlanGrid(statusInfo) {
        const plan = statusInfo.plan;

        if (plan === "premium") {
          return buildExtraCard();
        }

        if (plan === "normal") {
          return buildPremiumCard() + buildExtraCard();
        }

        return buildNormalCard() + buildPremiumCard() + buildExtraCard();
      }

      function buildReadingDoorway(statusInfo, usedFallback = false) {
        const displayInfo = getMembershipDisplayInfo(statusInfo?.plan);
        const planText = displayInfo.availablePlans
          .map((plan) => (plan === "deep" ? "深掘り鑑定" : plan === "light" ? "ライト鑑定" : "無料鑑定"))
          .join(" / ");
        const fallbackNote = usedFallback
          ? "取得できない場合は、安全のため無料会員として案内します。"
          : "一度受け取った鑑定は、あなたの人生ログとして残ります。";

        return `
          <section class="fortune-card" style="padding:34px; border-radius:28px; margin-bottom:28px; background: radial-gradient(circle at 88% 16%, rgba(177,124,255,0.12), transparent 30%), rgba(255,255,255,0.035);">
            <div style="display:inline-flex; padding:8px 14px; border-radius:999px; border:1px solid rgba(202,168,79,0.28); color:#f2dd9a; margin-bottom:16px;">
              READING DOORS
            </div>
            <h2 style="margin:0 0 10px; color:#fff0bf; font-size:2rem;">鑑定の扉を選ぶ</h2>
            <p style="margin:0 0 18px; color:#dbc979; line-height:1.9;">
              一度届けた鑑定は、あなたの人生ログとして残ります。<br />
              新しく詳しい鑑定を作る扉だけ、現在の会員状態または正式提供後に案内する追加権利で確認していきます。
            </p>
            <div style="margin:0 0 18px; padding:16px 18px; border-radius:18px; border:1px solid rgba(214,174,64,0.2); background:rgba(255,255,255,0.035);">
              <strong style="display:block; color:#fff0bf;">現在の会員ランク: ${escapeHtml(displayInfo.label)}</strong>
              <span style="display:block; margin-top:6px; color:rgba(255,236,179,0.74); line-height:1.75;">${escapeHtml(displayInfo.description)}</span>
              <span style="display:block; margin-top:6px; color:rgba(255,236,179,0.74); line-height:1.75;">新しく開ける扉: ${escapeHtml(planText)}</span>
              <small style="display:block; margin-top:10px; color:rgba(255,236,179,0.62); line-height:1.7;">${escapeHtml(fallbackNote)}</small>
            </div>
            <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:14px;">
              <a href="/premium/light" style="display:block; padding:18px; border-radius:18px; border:1px solid rgba(214,174,64,0.28); color:#fff0bf; background:rgba(255,255,255,0.04); text-decoration:none;">
                <strong style="display:block; margin-bottom:6px;">ライト鑑定の案内</strong>
                <span style="display:block; color:rgba(255,236,179,0.72); line-height:1.75;">light会員以上の方に向けた、少し詳しい鑑定です。</span>
              </a>
              <a href="/premium/deep" style="display:block; padding:18px; border-radius:18px; border:1px solid rgba(177,124,255,0.34); color:#fff0bf; background:rgba(177,124,255,0.06); text-decoration:none;">
                <strong style="display:block; margin-bottom:6px;">深掘り鑑定の案内</strong>
                <span style="display:block; color:rgba(255,236,179,0.72); line-height:1.75;">premium会員の方に向けた、多面的な鑑定です。</span>
              </a>
            </div>
            <p style="margin:18px 0 0; padding-top:16px; border-top:1px solid rgba(202,168,79,0.18); color:rgba(255,236,179,0.76); line-height:1.85;">
              今のあなたが選べる鑑定の扉を、ここで静かにご案内します。
            </p>
          </section>
        `;
      }

      function buildBillingMessage(statusInfo) {
        if (statusInfo.plan === "premium") {
          return statusInfo.cancelAtPeriodEnd
            ? `現在はプレミアム会員として表示されています。解約予約中ですが、${statusInfo.currentPeriodEnd ? formatDate(statusInfo.currentPeriodEnd) + " までは" : "次回更新日までは"}ご利用いただけます。今は追加のご案内だけを表示しています。`
            : "現在はプレミアム会員として表示されています。すでに選んでいる月額プランを重ねて申し込まないよう、今は追加のご案内だけを表示しています。";
        }

        if (statusInfo.plan === "normal") {
          return statusInfo.cancelAtPeriodEnd
            ? `現在はライト会員として表示されています。解約予約中ですが、${statusInfo.currentPeriodEnd ? formatDate(statusInfo.currentPeriodEnd) + " までは" : "次回更新日までは"}ご利用いただけます。今はプレミアム会員と単発音声のご案内を表示しています。`
            : "現在はライト会員として表示されています。今はプレミアム会員と単発音声のご案内を表示しています。";
        }

        return "";
      }

      async function fetchUserStatus() {
        if (!authSession || !USER_STATUS_ENDPOINT) {
          throw new Error("ログイン情報が見つかりません。");
        }

        const res = await fetch(USER_STATUS_ENDPOINT, { headers: { Authorization: `Bearer ${authSession}` } });
        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.error || "会員情報の取得に失敗しました。");
        }

        return {
          plan: normalizePlan(data.plan || "free"),
          cancelAtPeriodEnd: Boolean(data.cancel_at_period_end),
          currentPeriodEnd: data.current_period_end || "",
          raw: data
        };
      }

      function bindLogout() {
        if (authSession && email) {
          authArea.innerHTML = `
            <span class="fortune-user">${escapeHtml(email)}</span>
            <button id="logoutBtn" class="fortune-nav-logout" type="button">ログアウト</button>
          `;

          document.getElementById("logoutBtn").addEventListener("click", () => {
            localStorage.removeItem(AUTH_STORAGE_KEY);
            localStorage.removeItem("loginEmail");
            localStorage.removeItem("userId");
            localStorage.removeItem("user_id");
            window.location.href = "/";
          });
        } else {
          authArea.innerHTML = `
            <a href="/login?redirect=/premium" class="fortune-nav-pill">会員ログイン</a>
          `;
        }
      }

      async function renderPremiumPage() {
        bindLogout();

        if (!authSession) {
          premiumContent.innerHTML = `
            <section class="fortune-card" style="padding:40px; border-radius:28px;">
              <div style="display:inline-flex; padding:8px 14px; border-radius:999px; border:1px solid rgba(202,168,79,0.28); color:#f2dd9a; margin-bottom:18px;">
                MEMBER CONTENT
              </div>
              <h1 style="margin:0 0 14px; font-size:2.2rem; color:#fff0bf;">会員限定鑑定</h1>
              <p style="margin:0 0 24px; line-height:1.9; color:#dbc979;">
                このページを見るにはログインが必要です。
              </p>
              <div style="display:flex; flex-wrap:wrap; gap:12px;">
                <a href="/login?redirect=/premium" class="fortune-btn gold big">ログインして続きを見る</a>
                <a href="/" class="fortune-btn secondary">TOPへ戻る</a>
              </div>
            </section>
          `;
          return;
        }

        const name = input?.name || "あなた";

        let statusInfo = {
          plan: "free",
          cancelAtPeriodEnd: false,
          currentPeriodEnd: ""
        };

        let billingMessage = "";
        let usedMembershipFallback = false;
        try {
          statusInfo = await fetchUserStatus();
          billingMessage = buildBillingMessage(statusInfo);
        } catch (error) {
          console.error(error);
          billingMessage = "今の会員状態を確認できませんでした。安全のため、この画面では追加のご案内だけを表示します。";
          usedMembershipFallback = true;
          statusInfo = {
            plan: "premium",
            cancelAtPeriodEnd: false,
            currentPeriodEnd: ""
          };
        }

        const preparationMessage = "現在はfincode本番環境の審査・準備中です。プラン内容と申込条件は確認できますが、本番カード決済はまだ開始していません。";
        billingMessage = billingMessage
          ? `${billingMessage}\n${preparationMessage}`
          : preparationMessage;

        premiumContent.innerHTML = `
          <section class="fortune-card" style="padding:40px; border-radius:28px; margin-bottom:28px; background: linear-gradient(180deg, rgba(10,14,34,0.95), rgba(16,11,40,0.92));">
            <div style="display:inline-flex; padding:8px 14px; border-radius:999px; border:1px solid rgba(202,168,79,0.28); color:#f2dd9a; margin-bottom:18px;">
              MEMBER CONTENT
            </div>
            <h1 style="margin:0 0 14px; font-size:2.35rem; color:#fff0bf;">${escapeHtml(name)}さんの会員限定鑑定</h1>
            <p style="margin:0; line-height:1.95; color:#dbc979;">
              ここでは白音七メソッドの中核となる読みを味わえます。<br />
              無料版では見えなかった「本質」「流れ」「現在地」を、継続的に追えます。
            </p>
          </section>

          ${buildReadingDoorway(usedMembershipFallback ? { plan: "free" } : statusInfo, usedMembershipFallback)}

          <section class="fortune-card" style="padding:34px; border-radius:28px; margin-bottom:28px;">
            <div style="display:inline-flex; padding:8px 14px; border-radius:999px; border:1px solid rgba(202,168,79,0.28); color:#f2dd9a; margin-bottom:16px;">
              COURSE SELECT
            </div>
            <h2 style="margin:0 0 10px; color:#fff0bf; font-size:2rem;">悩みに合わせて選ぶ特別鑑定</h2>
            <p style="margin:0 0 8px; color:#dbc979; line-height:1.9;">
              今の会員状態に合わせて、選べる内容を表示しています。<br />
              すでに選んでいる月額プランを大切にしながら、必要なものだけを追加できる形にしています。
            </p>
            <p style="margin:0 0 24px; color:#f2dd9a;">
              プラン内容と価格を確認したうえで、必要なものをお選びいただけます。
            </p>

            <div id="billingMessage" style="display:${billingMessage ? "block" : "none"}; margin-bottom:18px; padding:14px 16px; border-radius:16px; border:1px solid rgba(202,168,79,0.35); background:rgba(202,168,79,0.08); color:#f5e8bf; line-height:1.8;">
              ${escapeHtml(billingMessage)}
            </div>

            <div id="planGrid" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:18px;">
              ${buildPlanGrid(statusInfo)}
            </div>
          </section>

          <section style="display:flex; flex-wrap:wrap; gap:12px;">
            <a href="/premium/light" class="fortune-btn gold">ライト鑑定の案内</a>
            <a href="/premium/deep" class="fortune-btn violet">深掘り鑑定の案内</a>
            <a href="/premium/voice" class="fortune-btn violet">音声鑑定ページへ</a>
            <a href="/history" class="fortune-btn secondary">履歴を見る</a>
            <a href="/members" class="fortune-btn gold">会員ページへ戻る</a>
            <a href="/join" class="fortune-btn secondary">プラン案内を見る</a>
          </section>
        `;

      }

      document.addEventListener("DOMContentLoaded", () => {
        renderPremiumPage();
      });
    </script>
  </body>
</html>
