          "BEDROCK_LIGHT_MODEL_ID": { "Ref": "LightModelId" }, "BEDROCK_LIGHT_MODEL_ALIAS": { "Ref": "LightModelAlias" },
          "BEDROCK_DEEP_MODEL_ID": { "Ref": "DeepModelId" }, "BEDROCK_DEEP_MODEL_ALIAS": { "Ref": "DeepModelAlias" },
          "USERS_TABLE_NAME": { "Ref": "ReadingUsersTable" }, "READING_HISTORY_TABLE_NAME": { "Ref": "ReadingHistoryTable" }, "READING_IDEMPOTENCY_TABLE_NAME": { "Ref": "ReadingIdempotencyTable" },
          "READING_RATE_LIMIT_TABLE_NAME": { "Ref": "ReadingRateLimitTable" }, "READING_DEEP_QUOTA_TABLE_NAME": { "Ref": "ReadingDeepQuotaTable" }, "READING_JOBS_TABLE_NAME": { "Ref": "ReadingJobsTable" },
          "AUDIT_HASH_SECRET": { "Fn::Sub": "{{resolve:secretsmanager:${RuntimeSecretsArn}:SecretString:audit_hash_secret}}" },
          "READING_IDEMPOTENCY_HASH_SECRET": { "Fn::Sub": "{{resolve:secretsmanager:${RuntimeSecretsArn}:SecretString:reading_idempotency_hash_secret}}" },
          "READING_DEEP_QUOTA_HASH_SECRET": { "Fn::Sub": "{{resolve:secretsmanager:${RuntimeSecretsArn}:SecretString:reading_deep_quota_hash_secret}}" },
          "READING_IDEMPOTENCY_LEASE_SECONDS": "120", "READING_IDEMPOTENCY_TTL_SECONDS": "604800", "READING_JOB_TTL_SECONDS": "604800",
