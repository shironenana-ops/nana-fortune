    "LightEventSourceMapping": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "Properties": { "EventSourceArn": { "Fn::GetAtt": ["LightQueue", "Arn"] }, "FunctionName": { "Ref": "LightWorkerFunction" }, "Enabled": { "Fn::If": ["WorkersEnabled", true, false] }, "BatchSize": 1, "FunctionResponseTypes": ["ReportBatchItemFailures"], "ScalingConfig": { "MaximumConcurrency": 5 } }
    },
    "DeepEventSourceMapping": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "Properties": { "EventSourceArn": { "Fn::GetAtt": ["DeepQueue", "Arn"] }, "FunctionName": { "Ref": "DeepWorkerFunction" }, "Enabled": { "Fn::If": ["WorkersEnabled", true, false] }, "BatchSize": 1, "FunctionResponseTypes": ["ReportBatchItemFailures"], "ScalingConfig": { "MaximumConcurrency": 5 } }
    },
    "ReadingHttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "ProtocolType": "HTTP",
        "CorsConfiguration": { "AllowOrigins": { "Ref": "AllowedOrigins" }, "AllowMethods": ["GET", "POST", "OPTIONS"], "AllowHeaders": ["Authorization", "Content-Type", "Idempotency-Key"], "MaxAge": 600 },
        "Tags": { "Project": "nana-fortune", "Environment": { "Ref": "Environment" }, "Component": "reading-http-api", "ManagedBy": "cloudformation" }
      }
    },
    "ReadingRequestIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": { "Ref": "ReadingHttpApi" }, "IntegrationType": "AWS_PROXY", "IntegrationMethod": "POST", "PayloadFormatVersion": "2.0", "TimeoutInMillis": 29000,
        "IntegrationUri": { "Fn::GetAtt": ["ReadingRequestFunction", "Arn"] }, "RequestParameters": { "overwrite:path": "'/reading/generate'" }
      }
    },
    "ReadingStatusIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": { "ApiId": { "Ref": "ReadingHttpApi" }, "IntegrationType": "AWS_PROXY", "IntegrationMethod": "POST", "PayloadFormatVersion": "2.0", "TimeoutInMillis": 10000, "IntegrationUri": { "Fn::GetAtt": ["ReadingStatusFunction", "Arn"] } }
    },
    "ReadingRequestRoute": { "Type": "AWS::ApiGatewayV2::Route", "Properties": { "ApiId": { "Ref": "ReadingHttpApi" }, "RouteKey": "POST /reading", "AuthorizationType": "NONE", "Target": { "Fn::Join": ["/", ["integrations", { "Ref": "ReadingRequestIntegration" }]] } } },
    "ReadingStatusRoute": { "Type": "AWS::ApiGatewayV2::Route", "Properties": { "ApiId": { "Ref": "ReadingHttpApi" }, "RouteKey": "GET /reading/status", "AuthorizationType": "NONE", "Target": { "Fn::Join": ["/", ["integrations", { "Ref": "ReadingStatusIntegration" }]] } } },
    "ReadingApiStage": { "Type": "AWS::ApiGatewayV2::Stage", "Properties": { "ApiId": { "Ref": "ReadingHttpApi" }, "StageName": { "Ref": "Environment" }, "AutoDeploy": true, "Tags": { "Project": "nana-fortune", "Environment": { "Ref": "Environment" }, "Component": "reading-http-api-stage", "ManagedBy": "cloudformation" } } },
    "ReadingRequestInvokePermission": { "Type": "AWS::Lambda::Permission", "Properties": { "Action": "lambda:InvokeFunction", "FunctionName": { "Ref": "ReadingRequestFunction" }, "Principal": "apigateway.amazonaws.com", "SourceArn": { "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${ReadingHttpApi}/${Environment}/POST/reading" } } },
    "ReadingStatusInvokePermission": { "Type": "AWS::Lambda::Permission", "Properties": { "Action": "lambda:InvokeFunction", "FunctionName": { "Ref": "ReadingStatusFunction" }, "Principal": "apigateway.amazonaws.com", "SourceArn": { "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${ReadingHttpApi}/${Environment}/GET/reading/status" } } }
  },
  "Outputs": {
    "ReadingApiId": { "Value": { "Ref": "ReadingHttpApi" } },
    "ReadingApiStageName": { "Value": { "Ref": "Environment" } },
    "LightQueueArn": { "Value": { "Fn::GetAtt": ["LightQueue", "Arn"] } },
    "DeepQueueArn": { "Value": { "Fn::GetAtt": ["DeepQueue", "Arn"] } },
    "LightDeadLetterQueueArn": { "Value": { "Fn::GetAtt": ["LightDeadLetterQueue", "Arn"] } },
    "DeepDeadLetterQueueArn": { "Value": { "Fn::GetAtt": ["DeepDeadLetterQueue", "Arn"] } }
  }
