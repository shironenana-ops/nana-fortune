          "READING_RATE_LIMIT_LIGHT_LIGHT_MAX": "3", "READING_RATE_LIMIT_LIGHT_LIGHT_WINDOW_SECONDS": "900", "READING_RATE_LIMIT_PREMIUM_FREE_MAX": "10", "READING_RATE_LIMIT_PREMIUM_FREE_WINDOW_SECONDS": "600",
          "READING_RATE_LIMIT_PREMIUM_LIGHT_MAX": "5", "READING_RATE_LIMIT_PREMIUM_LIGHT_WINDOW_SECONDS": "900", "READING_RATE_LIMIT_PREMIUM_DEEP_MAX": "2", "READING_RATE_LIMIT_PREMIUM_DEEP_WINDOW_SECONDS": "1800",
          "READING_CONCURRENCY_LIGHT_LIMIT": "1", "READING_CONCURRENCY_DEEP_LIMIT": "1", "READING_CONCURRENCY_LEASE_SECONDS": "180"
        } },
        "Tags": [{ "Key": "Project", "Value": "nana-fortune" }, { "Key": "Environment", "Value": { "Ref": "Environment" } }, { "Key": "Component", "Value": "reading-light-worker" }, { "Key": "ManagedBy", "Value": "cloudformation" }]
      }
    },
    "DeepWorkerFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": ["DeepWorkerLogGroup"],
