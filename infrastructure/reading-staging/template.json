{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Shirone paid reading asynchronous staging infrastructure (local implementation; disabled by default)",
  "Parameters": {
    "Environment": { "Type": "String", "Default": "staging", "AllowedValues": ["staging"] },
    "ArtifactBucketName": { "Type": "String", "MinLength": 3, "MaxLength": 63, "AllowedPattern": "^[a-z0-9][a-z0-9.-]+[a-z0-9]$" },
    "ReadingRequestArtifactKey": { "Type": "String", "MinLength": 1, "MaxLength": 1024 },
    "ReadingStatusArtifactKey": { "Type": "String", "MinLength": 1, "MaxLength": 1024 },
    "LightWorkerArtifactKey": { "Type": "String", "MinLength": 1, "MaxLength": 1024 },
    "DeepWorkerArtifactKey": { "Type": "String", "MinLength": 1, "MaxLength": 1024 },
    "AllowedOrigins": { "Type": "CommaDelimitedList", "Description": "Exact staging origins; wildcard is not allowed" },
    "RuntimeSecretsArn": { "Type": "String", "AllowedPattern": "^arn:aws:secretsmanager:ap-northeast-1:[0-9]{12}:secret:[A-Za-z0-9/_+=.@-]+$", "NoEcho": true },
    "Owner": { "Type": "String", "MinLength": 1, "MaxLength": 64 },
    "CostCenter": { "Type": "String", "MinLength": 1, "MaxLength": 64 },
    "ReadingGenerateApiEnabled": { "Type": "String", "Default": "false", "AllowedValues": ["false", "true"] },
    "ReadingAsyncPaidEnabled": { "Type": "String", "Default": "false", "AllowedValues": ["false", "true"] },
    "ReadingStatusApiEnabled": { "Type": "String", "Default": "false", "AllowedValues": ["false", "true"] },
    "ReadingBedrockEnabled": { "Type": "String", "Default": "false", "AllowedValues": ["false", "true"] },
    "WorkerEventSourceMappingsEnabled": { "Type": "String", "Default": "false", "AllowedValues": ["false", "true"] },
    "LightModelId": { "Type": "String", "AllowedPattern": "^jp\\.[A-Za-z0-9._:-]+$" },
    "LightModelAlias": { "Type": "String", "MinLength": 1, "MaxLength": 128 },
    "DeepModelId": { "Type": "String", "AllowedPattern": "^jp\\.[A-Za-z0-9._:-]+$" },
    "DeepModelAlias": { "Type": "String", "MinLength": 1, "MaxLength": 128 },
    "LightInferenceProfileArn": { "Type": "String", "AllowedPattern": "^arn:aws:bedrock:ap-northeast-1:[0-9]{12}:inference-profile/jp\\.[A-Za-z0-9._:-]+$" },
    "LightTokyoFoundationModelArn": { "Type": "String", "AllowedPattern": "^arn:aws:bedrock:ap-northeast-1::foundation-model/[A-Za-z0-9._:-]+$" },
    "LightOsakaFoundationModelArn": { "Type": "String", "AllowedPattern": "^arn:aws:bedrock:ap-northeast-3::foundation-model/[A-Za-z0-9._:-]+$" },
    "DeepInferenceProfileArn": { "Type": "String", "AllowedPattern": "^arn:aws:bedrock:ap-northeast-1:[0-9]{12}:inference-profile/jp\\.[A-Za-z0-9._:-]+$" },
    "DeepTokyoFoundationModelArn": { "Type": "String", "AllowedPattern": "^arn:aws:bedrock:ap-northeast-1::foundation-model/[A-Za-z0-9._:-]+$" },
    "DeepOsakaFoundationModelArn": { "Type": "String", "AllowedPattern": "^arn:aws:bedrock:ap-northeast-3::foundation-model/[A-Za-z0-9._:-]+$" }
  },
  "Conditions": {
    "WorkersEnabled": { "Fn::Equals": [{ "Ref": "WorkerEventSourceMappingsEnabled" }, "true"] }
  },
  "Resources": {
    "ReadingUsersTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [{ "AttributeName": "user_id", "AttributeType": "S" }],
        "KeySchema": [{ "AttributeName": "user_id", "KeyType": "HASH" }],
        "DeletionProtectionEnabled": true,
        "PointInTimeRecoverySpecification": { "PointInTimeRecoveryEnabled": true },
        "SSESpecification": { "SSEEnabled": true },
        "Tags": [
          { "Key": "Project", "Value": "nana-fortune" }, { "Key": "Environment", "Value": { "Ref": "Environment" } },
          { "Key": "Component", "Value": "reading-users" }, { "Key": "DataClassification", "Value": "confidential" },
          { "Key": "Owner", "Value": { "Ref": "Owner" } }, { "Key": "CostCenter", "Value": { "Ref": "CostCenter" } },
          { "Key": "ManagedBy", "Value": "cloudformation" }
        ]
      }
    },
    "ReadingHistoryTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [{ "AttributeName": "user_id", "AttributeType": "S" }, { "AttributeName": "history_id", "AttributeType": "S" }],
        "KeySchema": [{ "AttributeName": "user_id", "KeyType": "HASH" }, { "AttributeName": "history_id", "KeyType": "RANGE" }],
        "DeletionProtectionEnabled": true,
        "PointInTimeRecoverySpecification": { "PointInTimeRecoveryEnabled": true },
        "SSESpecification": { "SSEEnabled": true },
        "Tags": [
          { "Key": "Project", "Value": "nana-fortune" }, { "Key": "Environment", "Value": { "Ref": "Environment" } },
          { "Key": "Component", "Value": "reading-history" }, { "Key": "DataClassification", "Value": "confidential" },
          { "Key": "Owner", "Value": { "Ref": "Owner" } }, { "Key": "CostCenter", "Value": { "Ref": "CostCenter" } },
          { "Key": "ManagedBy", "Value": "cloudformation" }
        ]
      }
    },
    "ReadingIdempotencyTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [{ "AttributeName": "request_ref", "AttributeType": "S" }],
        "KeySchema": [{ "AttributeName": "request_ref", "KeyType": "HASH" }],
        "TimeToLiveSpecification": { "AttributeName": "expires_at", "Enabled": true },
        "DeletionProtectionEnabled": true,
        "PointInTimeRecoverySpecification": { "PointInTimeRecoveryEnabled": true },
        "SSESpecification": { "SSEEnabled": true },
        "Tags": [
          { "Key": "Project", "Value": "nana-fortune" }, { "Key": "Environment", "Value": { "Ref": "Environment" } },
          { "Key": "Component", "Value": "reading-idempotency" }, { "Key": "DataClassification", "Value": "internal" },
          { "Key": "Owner", "Value": { "Ref": "Owner" } }, { "Key": "CostCenter", "Value": { "Ref": "CostCenter" } },
          { "Key": "ManagedBy", "Value": "cloudformation" }
        ]
      }
    },
    "ReadingRateLimitTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [{ "AttributeName": "rate_limit_ref", "AttributeType": "S" }],
        "KeySchema": [{ "AttributeName": "rate_limit_ref", "KeyType": "HASH" }],
        "TimeToLiveSpecification": { "AttributeName": "expires_at", "Enabled": true },
        "DeletionProtectionEnabled": true,
        "PointInTimeRecoverySpecification": { "PointInTimeRecoveryEnabled": true },
        "SSESpecification": { "SSEEnabled": true },
        "Tags": [
          { "Key": "Project", "Value": "nana-fortune" }, { "Key": "Environment", "Value": { "Ref": "Environment" } },
          { "Key": "Component", "Value": "reading-rate-limit" }, { "Key": "DataClassification", "Value": "internal" },
          { "Key": "Owner", "Value": { "Ref": "Owner" } }, { "Key": "CostCenter", "Value": { "Ref": "CostCenter" } },
          { "Key": "ManagedBy", "Value": "cloudformation" }
        ]
      }
    },
    "ReadingDeepQuotaTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [{ "AttributeName": "quota_ref", "AttributeType": "S" }],
        "KeySchema": [{ "AttributeName": "quota_ref", "KeyType": "HASH" }],
        "TimeToLiveSpecification": { "AttributeName": "expires_at", "Enabled": true },
        "DeletionProtectionEnabled": true,
        "PointInTimeRecoverySpecification": { "PointInTimeRecoveryEnabled": true },
        "SSESpecification": { "SSEEnabled": true },
        "Tags": [
          { "Key": "Project", "Value": "nana-fortune" }, { "Key": "Environment", "Value": { "Ref": "Environment" } },
          { "Key": "Component", "Value": "reading-deep-quota" }, { "Key": "DataClassification", "Value": "internal" },
          { "Key": "Owner", "Value": { "Ref": "Owner" } }, { "Key": "CostCenter", "Value": { "Ref": "CostCenter" } },
          { "Key": "ManagedBy", "Value": "cloudformation" }
        ]
      }
    },
    "ReadingJobsTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [{ "AttributeName": "job_ref", "AttributeType": "S" }],
        "KeySchema": [{ "AttributeName": "job_ref", "KeyType": "HASH" }],
        "TimeToLiveSpecification": { "AttributeName": "expires_at", "Enabled": true },
        "DeletionProtectionEnabled": true,
        "PointInTimeRecoverySpecification": { "PointInTimeRecoveryEnabled": false },
        "SSESpecification": { "SSEEnabled": true },
        "Tags": [
          { "Key": "Project", "Value": "nana-fortune" }, { "Key": "Environment", "Value": { "Ref": "Environment" } },
          { "Key": "Component", "Value": "reading-jobs" }, { "Key": "DataClassification", "Value": "confidential" },
          { "Key": "Owner", "Value": { "Ref": "Owner" } }, { "Key": "CostCenter", "Value": { "Ref": "CostCenter" } },
          { "Key": "ManagedBy", "Value": "cloudformation" }
        ]
      }
    },
    "LightDeadLetterQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "MessageRetentionPeriod": 1209600,
        "SqsManagedSseEnabled": true,
        "Tags": [{ "Key": "Project", "Value": "nana-fortune" }, { "Key": "Environment", "Value": { "Ref": "Environment" } }, { "Key": "Component", "Value": "reading-light-dlq" }, { "Key": "ManagedBy", "Value": "cloudformation" }]
      }
    },
    "DeepDeadLetterQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "MessageRetentionPeriod": 1209600,
        "SqsManagedSseEnabled": true,
        "Tags": [{ "Key": "Project", "Value": "nana-fortune" }, { "Key": "Environment", "Value": { "Ref": "Environment" } }, { "Key": "Component", "Value": "reading-deep-dlq" }, { "Key": "ManagedBy", "Value": "cloudformation" }]
      }
    },
    "LightQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "VisibilityTimeout": 720,
        "MessageRetentionPeriod": 86400,
        "SqsManagedSseEnabled": true,
        "RedrivePolicy": { "deadLetterTargetArn": { "Fn::GetAtt": ["LightDeadLetterQueue", "Arn"] }, "maxReceiveCount": 5 },
        "Tags": [{ "Key": "Project", "Value": "nana-fortune" }, { "Key": "Environment", "Value": { "Ref": "Environment" } }, { "Key": "Component", "Value": "reading-light-queue" }, { "Key": "ManagedBy", "Value": "cloudformation" }]
      }
    },
    "DeepQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "VisibilityTimeout": 1440,
        "MessageRetentionPeriod": 86400,
        "SqsManagedSseEnabled": true,
        "RedrivePolicy": { "deadLetterTargetArn": { "Fn::GetAtt": ["DeepDeadLetterQueue", "Arn"] }, "maxReceiveCount": 5 },
        "Tags": [{ "Key": "Project", "Value": "nana-fortune" }, { "Key": "Environment", "Value": { "Ref": "Environment" } }, { "Key": "Component", "Value": "reading-deep-queue" }, { "Key": "ManagedBy", "Value": "cloudformation" }]
      }
    },
    "ReadingRequestLogGroup": { "Type": "AWS::Logs::LogGroup", "DeletionPolicy": "Retain", "UpdateReplacePolicy": "Retain", "Properties": { "LogGroupName": { "Fn::Sub": "/aws/lambda/${AWS::StackName}-reading-request" }, "RetentionInDays": 30 } },
    "ReadingStatusLogGroup": { "Type": "AWS::Logs::LogGroup", "DeletionPolicy": "Retain", "UpdateReplacePolicy": "Retain", "Properties": { "LogGroupName": { "Fn::Sub": "/aws/lambda/${AWS::StackName}-reading-status" }, "RetentionInDays": 30 } },
    "LightWorkerLogGroup": { "Type": "AWS::Logs::LogGroup", "DeletionPolicy": "Retain", "UpdateReplacePolicy": "Retain", "Properties": { "LogGroupName": { "Fn::Sub": "/aws/lambda/${AWS::StackName}-reading-light-worker" }, "RetentionInDays": 30 } },
    "DeepWorkerLogGroup": { "Type": "AWS::Logs::LogGroup", "DeletionPolicy": "Retain", "UpdateReplacePolicy": "Retain", "Properties": { "LogGroupName": { "Fn::Sub": "/aws/lambda/${AWS::StackName}-reading-deep-worker" }, "RetentionInDays": 30 } },
    "ReadingRequestRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Principal": { "Service": "lambda.amazonaws.com" }, "Action": "sts:AssumeRole" }] },
        "Policies": [{
          "PolicyName": "reading-request-staging-minimum",
          "PolicyDocument": { "Version": "2012-10-17", "Statement": [
            { "Sid": "OwnLogs", "Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": { "Fn::GetAtt": ["ReadingRequestLogGroup", "Arn"] } },
            { "Sid": "ReadState", "Effect": "Allow", "Action": "dynamodb:GetItem", "Resource": [
              { "Fn::GetAtt": ["ReadingUsersTable", "Arn"] }, { "Fn::GetAtt": ["ReadingHistoryTable", "Arn"] }, { "Fn::GetAtt": ["ReadingIdempotencyTable", "Arn"] },
              { "Fn::GetAtt": ["ReadingRateLimitTable", "Arn"] }, { "Fn::GetAtt": ["ReadingDeepQuotaTable", "Arn"] }, { "Fn::GetAtt": ["ReadingJobsTable", "Arn"] }
            ] },
            { "Sid": "WriteStateItems", "Effect": "Allow", "Action": ["dynamodb:PutItem", "dynamodb:UpdateItem"], "Resource": [
              { "Fn::GetAtt": ["ReadingHistoryTable", "Arn"] }, { "Fn::GetAtt": ["ReadingIdempotencyTable", "Arn"] }, { "Fn::GetAtt": ["ReadingRateLimitTable", "Arn"] },
              { "Fn::GetAtt": ["ReadingDeepQuotaTable", "Arn"] }, { "Fn::GetAtt": ["ReadingJobsTable", "Arn"] }
            ] },
            { "Sid": "WriteStateTransactions", "Effect": "Allow", "Action": "dynamodb:TransactWriteItems", "Resource": [
              { "Fn::GetAtt": ["ReadingUsersTable", "Arn"] }, { "Fn::GetAtt": ["ReadingHistoryTable", "Arn"] }, { "Fn::GetAtt": ["ReadingIdempotencyTable", "Arn"] },
              { "Fn::GetAtt": ["ReadingRateLimitTable", "Arn"] }, { "Fn::GetAtt": ["ReadingDeepQuotaTable", "Arn"] }, { "Fn::GetAtt": ["ReadingJobsTable", "Arn"] }
            ] },
            { "Sid": "EnqueuePaidJobs", "Effect": "Allow", "Action": "sqs:SendMessage", "Resource": [{ "Fn::GetAtt": ["LightQueue", "Arn"] }, { "Fn::GetAtt": ["DeepQueue", "Arn"] }] }
          ] }
        }],
        "Tags": [{ "Key": "Project", "Value": "nana-fortune" }, { "Key": "Environment", "Value": { "Ref": "Environment" } }, { "Key": "Component", "Value": "reading-request-role" }, { "Key": "ManagedBy", "Value": "cloudformation" }]
      }
    },
    "ReadingStatusRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Principal": { "Service": "lambda.amazonaws.com" }, "Action": "sts:AssumeRole" }] },
        "Policies": [{
          "PolicyName": "reading-status-staging-read-only",
          "PolicyDocument": { "Version": "2012-10-17", "Statement": [
            { "Sid": "OwnLogs", "Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": { "Fn::GetAtt": ["ReadingStatusLogGroup", "Arn"] } },
            { "Sid": "ReadOwnedStatus", "Effect": "Allow", "Action": "dynamodb:GetItem", "Resource": [{ "Fn::GetAtt": ["ReadingJobsTable", "Arn"] }, { "Fn::GetAtt": ["ReadingHistoryTable", "Arn"] }] }
          ] }
        }],
        "Tags": [{ "Key": "Project", "Value": "nana-fortune" }, { "Key": "Environment", "Value": { "Ref": "Environment" } }, { "Key": "Component", "Value": "reading-status-role" }, { "Key": "ManagedBy", "Value": "cloudformation" }]
      }
    },
    "LightWorkerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Principal": { "Service": "lambda.amazonaws.com" }, "Action": "sts:AssumeRole" }] },
        "Policies": [{
          "PolicyName": "reading-light-worker-staging-minimum",
          "PolicyDocument": { "Version": "2012-10-17", "Statement": [
            { "Sid": "OwnLogs", "Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": { "Fn::GetAtt": ["LightWorkerLogGroup", "Arn"] } },
            { "Sid": "ConsumeLightOnly", "Effect": "Allow", "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:ChangeMessageVisibility", "sqs:GetQueueAttributes"], "Resource": { "Fn::GetAtt": ["LightQueue", "Arn"] } },
            { "Sid": "ReadLightState", "Effect": "Allow", "Action": "dynamodb:GetItem", "Resource": [
              { "Fn::GetAtt": ["ReadingJobsTable", "Arn"] }, { "Fn::GetAtt": ["ReadingHistoryTable", "Arn"] }, { "Fn::GetAtt": ["ReadingIdempotencyTable", "Arn"] }, { "Fn::GetAtt": ["ReadingRateLimitTable", "Arn"] }
            ] },
            { "Sid": "UpdateLightJob", "Effect": "Allow", "Action": "dynamodb:UpdateItem", "Resource": { "Fn::GetAtt": ["ReadingJobsTable", "Arn"] } },
            { "Sid": "WriteLightTransactions", "Effect": "Allow", "Action": "dynamodb:TransactWriteItems", "Resource": [
              { "Fn::GetAtt": ["ReadingJobsTable", "Arn"] }, { "Fn::GetAtt": ["ReadingHistoryTable", "Arn"] }, { "Fn::GetAtt": ["ReadingIdempotencyTable", "Arn"] }, { "Fn::GetAtt": ["ReadingRateLimitTable", "Arn"] }
            ] },
            { "Sid": "InvokeLightProfile", "Effect": "Allow", "Action": "bedrock:InvokeModel", "Resource": { "Ref": "LightInferenceProfileArn" } },
            { "Sid": "InvokeLightModelsThroughProfile", "Effect": "Allow", "Action": "bedrock:InvokeModel", "Resource": [{ "Ref": "LightTokyoFoundationModelArn" }, { "Ref": "LightOsakaFoundationModelArn" }], "Condition": { "StringEquals": { "bedrock:InferenceProfileArn": { "Ref": "LightInferenceProfileArn" } } } }
          ] }
        }],
        "Tags": [{ "Key": "Project", "Value": "nana-fortune" }, { "Key": "Environment", "Value": { "Ref": "Environment" } }, { "Key": "Component", "Value": "reading-light-worker-role" }, { "Key": "ManagedBy", "Value": "cloudformation" }]
      }
    },
    "DeepWorkerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Principal": { "Service": "lambda.amazonaws.com" }, "Action": "sts:AssumeRole" }] },
        "Policies": [{
          "PolicyName": "reading-deep-worker-staging-minimum",
          "PolicyDocument": { "Version": "2012-10-17", "Statement": [
            { "Sid": "OwnLogs", "Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": { "Fn::GetAtt": ["DeepWorkerLogGroup", "Arn"] } },
            { "Sid": "ConsumeDeepOnly", "Effect": "Allow", "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:ChangeMessageVisibility", "sqs:GetQueueAttributes"], "Resource": { "Fn::GetAtt": ["DeepQueue", "Arn"] } },
            { "Sid": "ReadDeepState", "Effect": "Allow", "Action": "dynamodb:GetItem", "Resource": [
              { "Fn::GetAtt": ["ReadingJobsTable", "Arn"] }, { "Fn::GetAtt": ["ReadingHistoryTable", "Arn"] }, { "Fn::GetAtt": ["ReadingIdempotencyTable", "Arn"] },
              { "Fn::GetAtt": ["ReadingRateLimitTable", "Arn"] }, { "Fn::GetAtt": ["ReadingDeepQuotaTable", "Arn"] }
            ] },
            { "Sid": "UpdateDeepJob", "Effect": "Allow", "Action": "dynamodb:UpdateItem", "Resource": { "Fn::GetAtt": ["ReadingJobsTable", "Arn"] } },
            { "Sid": "WriteDeepTransactions", "Effect": "Allow", "Action": "dynamodb:TransactWriteItems", "Resource": [
              { "Fn::GetAtt": ["ReadingUsersTable", "Arn"] }, { "Fn::GetAtt": ["ReadingJobsTable", "Arn"] }, { "Fn::GetAtt": ["ReadingHistoryTable", "Arn"] },
              { "Fn::GetAtt": ["ReadingIdempotencyTable", "Arn"] }, { "Fn::GetAtt": ["ReadingRateLimitTable", "Arn"] }, { "Fn::GetAtt": ["ReadingDeepQuotaTable", "Arn"] }
            ] },
            { "Sid": "InvokeDeepProfile", "Effect": "Allow", "Action": "bedrock:InvokeModel", "Resource": { "Ref": "DeepInferenceProfileArn" } },
            { "Sid": "InvokeDeepModelsThroughProfile", "Effect": "Allow", "Action": "bedrock:InvokeModel", "Resource": [{ "Ref": "DeepTokyoFoundationModelArn" }, { "Ref": "DeepOsakaFoundationModelArn" }], "Condition": { "StringEquals": { "bedrock:InferenceProfileArn": { "Ref": "DeepInferenceProfileArn" } } } }
          ] }
        }],
        "Tags": [{ "Key": "Project", "Value": "nana-fortune" }, { "Key": "Environment", "Value": { "Ref": "Environment" } }, { "Key": "Component", "Value": "reading-deep-worker-role" }, { "Key": "ManagedBy", "Value": "cloudformation" }]
      }
    },
    "ReadingRequestFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": ["ReadingRequestLogGroup"],
      "Properties": {
        "FunctionName": { "Fn::Sub": "${AWS::StackName}-reading-request" },
        "Runtime": "nodejs22.x", "Handler": "index.handler", "Timeout": 15, "MemorySize": 512, "ReservedConcurrentExecutions": 5,
        "Role": { "Fn::GetAtt": ["ReadingRequestRole", "Arn"] },
        "Code": { "S3Bucket": { "Ref": "ArtifactBucketName" }, "S3Key": { "Ref": "ReadingRequestArtifactKey" } },
        "Environment": { "Variables": {
          "READING_GENERATE_API_ENABLED": { "Ref": "ReadingGenerateApiEnabled" }, "READING_ASYNC_PAID_ENABLED": { "Ref": "ReadingAsyncPaidEnabled" },
          "ALLOWED_ORIGINS": { "Fn::Join": [",", { "Ref": "AllowedOrigins" }] }, "USERS_TABLE_NAME": { "Ref": "ReadingUsersTable" },
          "READING_HISTORY_TABLE_NAME": { "Ref": "ReadingHistoryTable" }, "READING_IDEMPOTENCY_TABLE_NAME": { "Ref": "ReadingIdempotencyTable" },
          "READING_RATE_LIMIT_TABLE_NAME": { "Ref": "ReadingRateLimitTable" }, "READING_DEEP_QUOTA_TABLE_NAME": { "Ref": "ReadingDeepQuotaTable" }, "READING_JOBS_TABLE_NAME": { "Ref": "ReadingJobsTable" },
          "READING_LIGHT_QUEUE_URL": { "Ref": "LightQueue" }, "READING_DEEP_QUEUE_URL": { "Ref": "DeepQueue" },
          "SESSION_TOKEN_SECRET": { "Fn::Sub": "{{resolve:secretsmanager:${RuntimeSecretsArn}:SecretString:session_token_secret}}" },
          "AUDIT_HASH_SECRET": { "Fn::Sub": "{{resolve:secretsmanager:${RuntimeSecretsArn}:SecretString:audit_hash_secret}}" },
          "READING_IDEMPOTENCY_HASH_SECRET": { "Fn::Sub": "{{resolve:secretsmanager:${RuntimeSecretsArn}:SecretString:reading_idempotency_hash_secret}}" },
          "READING_DEEP_QUOTA_HASH_SECRET": { "Fn::Sub": "{{resolve:secretsmanager:${RuntimeSecretsArn}:SecretString:reading_deep_quota_hash_secret}}" },
          "READING_IDEMPOTENCY_LEASE_SECONDS": "120", "READING_IDEMPOTENCY_TTL_SECONDS": "604800", "READING_JOB_TTL_SECONDS": "604800",
          "READING_LIGHT_JOB_LEASE_SECONDS": "180", "READING_DEEP_JOB_LEASE_SECONDS": "360", "READING_JOB_ORPHAN_GRACE_SECONDS": "60", "READING_DEEP_RESERVATION_SECONDS": "600",
          "READING_RATE_LIMIT_FREE_FREE_MAX": "10", "READING_RATE_LIMIT_FREE_FREE_WINDOW_SECONDS": "600", "READING_RATE_LIMIT_LIGHT_FREE_MAX": "10", "READING_RATE_LIMIT_LIGHT_FREE_WINDOW_SECONDS": "600",
          "READING_RATE_LIMIT_LIGHT_LIGHT_MAX": "3", "READING_RATE_LIMIT_LIGHT_LIGHT_WINDOW_SECONDS": "900", "READING_RATE_LIMIT_PREMIUM_FREE_MAX": "10", "READING_RATE_LIMIT_PREMIUM_FREE_WINDOW_SECONDS": "600",
          "READING_RATE_LIMIT_PREMIUM_LIGHT_MAX": "5", "READING_RATE_LIMIT_PREMIUM_LIGHT_WINDOW_SECONDS": "900", "READING_RATE_LIMIT_PREMIUM_DEEP_MAX": "2", "READING_RATE_LIMIT_PREMIUM_DEEP_WINDOW_SECONDS": "1800",
